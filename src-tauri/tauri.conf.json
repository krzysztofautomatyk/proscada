{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProScada",
  "version": "1.0.0",
  "identifier": "com.proscada.workstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ProScada — Engineering Workstation · v1.0 Designer",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "High-assurance SCADA designer and runtime",
    "longDescription": "ProScada is a Modbus TCP SCADA engineering workstation and operator runtime with Visual Studio-style form designer, audit trail, and Water Tank dual-pump HMI. Training/lab tool — not a certified safety or medical device."
  },
  "plugins": {}
}
