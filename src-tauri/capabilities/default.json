{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ProScada default capability — project storage locations only. $HOME is deliberately NOT in scope: it would expose ~/.ssh, ~/.aws and shell start-up files to any frontend code.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "dialog:default",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$APPDATA/**" }
      ],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.config/**" }
      ]
    }
  ]
}
